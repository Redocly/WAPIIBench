# Generated per-task material: the split-layout client (client.ts + client.schemas.ts +
# runtime/), a node_modules symlink and the parameter-type table, per task.
# Rebuildable with `python split/build_clients_split.py`. Not source.
work/
work_pruned/
# Driver output (estimate/score_driver.py --work-root split/work* --out split/results/...).
# The scored result of the run is source-of-record and IS tracked; nothing else here is.
results/*
!results/results_split.json
# Rendered blinded prompts: one per sampled task, regenerated by
# split/build_manifest_split.py from the dataset task text + the generated client.
prompts/
prompts_pruned/
__pycache__/
